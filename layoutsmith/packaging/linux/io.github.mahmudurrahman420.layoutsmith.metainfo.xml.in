<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.mahmudurrahman420.layoutsmith</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Layoutsmith</name>
  <summary>Lay out magazines, books and print documents</summary>
  <developer id="io.github.mahmudurrahman420">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      Layoutsmith is a page layout. Lay out magazines, books and print documents
    </p>
  </description>
  <launchable type="desktop-id">io.github.mahmudurrahman420.layoutsmith.desktop</launchable>
  <icon type="stock">io.github.mahmudurrahman420.layoutsmith</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mahmudurrahman420/layoutsmith</url>
  <url type="bugtracker">https://github.com/storytold/designcraft/issues</url>
  <url type="help">https://github.com/mahmudurrahman420/layoutsmith</url>
  <url type="contact">https://github.com/mahmudurrahman420/layoutsmith/discussions</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Magazine spread with threaded text frames and layout properties</caption>
      <image type="source" width="1600" height="1000">https://raw.githubusercontent.com/mahmudurrahman420/layoutsmith/main/docs/images/ui-spread.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>layoutsmith</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
