<?xml version="1.0" encoding="utf-8"?>
<!--
  Texsmith MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build texsmith.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.tcraft` owned by Texsmith,
  and Texsmith offered under "Open with" for the mesh formats it opens (without taking over
  the user's default app for them).

  UpgradeCode is Texsmith's for good: generated once (2026-10-14), never change it, or new
  versions install beside old ones instead of replacing them.
-->
<?define MeshExtensions = glb;gltf;fbx;dae;usd;usda;usdc;usdz;abc;obj;ply;stl ?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Texsmith"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="7E670E60-BB22-4E6B-8749-DD3FD4CA8979"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Texsmith 3D texture painter" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Texsmith is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="TexsmithIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="TexsmithIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mahmudurrahman420/texsmith" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/mahmudurrahman420/texsmith" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mahmudurrahman420/texsmith/discussions" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Texsmith" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Texsmith" Level="1">
      <ComponentGroupRef Id="TexsmithFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="TexsmithFiles" Directory="INSTALLFOLDER">
      <Component Id="TexsmithApp">
        <File Id="TexsmithExe" Source="$(var.BinDir)\texsmith.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Texsmith"
              Description="Texsmith 3D texture painter" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="TexsmithIcon.exe" IconIndex="0" />
        </File>

        <!-- .tcraft: Texsmith's own project format; Texsmith is its default app. -->
        <ProgId Id="Texsmith.Project" Description="Texsmith Project" Icon="TexsmithExe" IconIndex="0">
          <Extension Id="tcraft" ContentType="application/x-texsmith">
            <Verb Id="open" Command="Open" TargetFile="TexsmithExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Meshes (formats mesh_import::MESH_EXTENSIONS): offered under "Open with", never forced
             as the default. -->
        <ProgId Id="Texsmith.Mesh" Description="3D Model" Icon="TexsmithExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Texsmith.Mesh\shell\open\command" Value="&quot;[#TexsmithExe]&quot; &quot;%1&quot;" Type="string" />
        <?foreach Ext in $(var.MeshExtensions)?>
        <RegistryValue Root="HKLM" Key="Software\Classes\.$(var.Ext)\OpenWithProgids" Name="Texsmith.Mesh" Value="" Type="string" />
        <?endforeach?>

        <!-- "Open with" app list and the Run dialog (Win+R "texsmith"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\texsmith.exe" Name="FriendlyAppName" Value="Texsmith" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\texsmith.exe\shell\open\command" Value="&quot;[#TexsmithExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\texsmith.exe\SupportedTypes" Name=".tcraft" Value="" Type="string" />
        <?foreach Ext in $(var.MeshExtensions)?>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\texsmith.exe\SupportedTypes" Name=".$(var.Ext)" Value="" Type="string" />
        <?endforeach?>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\texsmith.exe" Value="[#TexsmithExe]" Type="string" />
      </Component>

      <Component Id="TexsmithCli">
        <File Id="TexsmithCliExe" Source="$(var.BinDir)\texsmith-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
