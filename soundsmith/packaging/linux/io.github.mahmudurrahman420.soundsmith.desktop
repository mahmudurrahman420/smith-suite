[Desktop Entry]
Type=Application
Name=Soundsmith
GenericName=Digital Audio Workstation
Comment=Record, edit and mix audio and MIDI
Exec=soundsmith %F
TryExec=soundsmith
Icon=io.github.mahmudurrahman420.soundsmith
Terminal=false
StartupNotify=true
StartupWMClass=io.github.mahmudurrahman420.soundsmith
Categories=AudioVideo;Audio;Midi;Mixer;Sequencer;Recorder;
MimeType=application/x-soundsmith-session;audio/x-wav;audio/wav;audio/vnd.wave;audio/x-aiff;audio/aiff;audio/flac;audio/x-flac;audio/mpeg;audio/midi;audio/x-midi;
Keywords=daw;audio;mixer;recording;multitrack;midi;editor;music;
