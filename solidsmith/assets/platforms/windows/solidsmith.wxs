<?xml version="1.0" encoding="utf-8"?>
<!--
  Solidsmith MSI (WiX Toolset v5, plus the UI and Util extensions). Built by package.ps1:

    wix build solidsmith.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc solidsmith.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install with a setup wizard: Welcome, install folder (Program Files\Solidsmith by
  default, remembered for upgrades), Ready, progress, and a Finish page with a ticked "Launch
  Solidsmith" box. Installs a Start Menu shortcut, solidsmith-cli (and adds its folder to the system PATH), the licence files (including
  THIRD-PARTY-LICENSES.txt), makes Solidsmith the owner of `.sc` (and of the older `.solidsmith` and pre-rename `.solvecraft`), and offers it under
  "Open with" for STEP, IGES, 3MF and STL. `msiexec /qn` installs silently.
  Adapted from Pixelsmith's (mahmudurrahman420/pixelsmith, Apache-2.0; see ATTRIBUTION.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Never change the UpgradeCode: it is what lets a new MSI replace every earlier install,
       including those from before the SolveCraft -> Solidsmith rename (docs/compatibility.md). -->
  <Package
      Name="Solidsmith"
      Manufacturer="Solidsmith contributors"
      Version="$(var.Version)"
      UpgradeCode="6A145FD6-D285-428D-AE84-A69570CDF4DB"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Solidsmith parametric 3D CAD" Manufacturer="Solidsmith contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Solidsmith is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Advertised shortcuts to an .exe need an .exe icon identifier (ICE50). -->
    <Icon Id="SolidsmithIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SolidsmithIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://docs.solidsmith.io/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/bherbruck/solidsmith/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bherbruck/solidsmith/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Solidsmith" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by SolidsmithApp). -->
    <!-- Since the rename the folder and this key say Solidsmith. A pre-rename install recorded
         Software\SolveCraft, which isn't read: its upgrade (same UpgradeCode) removes the old
         folder and installs into Program Files\Solidsmith (docs/compatibility.md). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Solidsmith" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Solidsmith" Level="1">
      <ComponentGroupRef Id="SolidsmithFiles" />
    </Feature>

    <!-- WixUI_InstallDir without its licence page (MIT OR Apache-2.0: nothing to accept). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSolidsmith"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="SolidsmithVersion" Value="$(var.DisplayVersion)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Solidsmith $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Solidsmith" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#SolidsmithExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user. -->
    <CustomAction Id="LaunchSolidsmith" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="SolidsmithFiles" Directory="INSTALLFOLDER">
      <!-- A new GUID with the rename: the key file changed from solvecraft.exe to solidsmith.exe.
           The UpgradeCode above is unchanged, so this MSI major-upgrades a pre-rename install. -->
      <Component Id="SolidsmithApp" Guid="A379D509-D776-4B34-A3A4-71FBF5724971">
        <File Id="SolidsmithExe" Source="$(var.BinDir)\solidsmith.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Solidsmith"
              Description="Solidsmith parametric 3D CAD" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="SolidsmithIcon.exe" IconIndex="0" />
        </File>

        <!-- .sc: Solidsmith's own format; Solidsmith is its default app. -->
        <ProgId Id="Solidsmith.Design" Description="Solidsmith Design" Icon="SolidsmithExe" IconIndex="0">
          <Extension Id="sc" ContentType="application/x-solidsmith">
            <Verb Id="open" Command="Open" TargetFile="SolidsmithExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Compatibility shim (docs/compatibility.md): designs saved as .solidsmith (before .sc)
             and as .solvecraft (before the rename) open as the same ProgId. Registered by hand: a
             second Extension under one ProgId would write its open verb twice (WIX0091). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidsmith" Value="Solidsmith.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidsmith" Name="Content Type" Value="application/x-solidsmith" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Value="Solidsmith.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Name="Content Type" Value="application/x-solvecraft" Type="string" />
        <!-- STEP, IGES and meshes: offered under "Open with", never forced as the default. -->
        <ProgId Id="Solidsmith.Model" Description="3D model" Icon="SolidsmithExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Solidsmith.Model\shell\open\command" Value="&quot;[#SolidsmithExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.step\OpenWithProgids" Name="Solidsmith.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stp\OpenWithProgids" Name="Solidsmith.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.igs\OpenWithProgids" Name="Solidsmith.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.iges\OpenWithProgids" Name="Solidsmith.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.3mf\OpenWithProgids" Name="Solidsmith.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stl\OpenWithProgids" Name="Solidsmith.Model" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "solidsmith"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe" Name="FriendlyAppName" Value="Solidsmith" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\shell\open\command" Value="&quot;[#SolidsmithExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".sc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".solidsmith" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".solvecraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".step" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".stp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".igs" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".iges" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".3mf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\solidsmith.exe\SupportedTypes" Name=".stl" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\solidsmith.exe" Value="[#SolidsmithExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Solidsmith" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="SolidsmithCli">
        <File Id="SolidsmithCliExe" Source="$(var.BinDir)\solidsmith-cli.exe" KeyPath="yes" />
        <!-- The install folder on the system PATH, so MCP clients and shells find `solidsmith-cli` by name;
             removed again on uninstall. -->
        <Environment Id="SolidsmithPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <!-- Compatibility shim (docs/compatibility.md): the old CLI name, forwarding to solidsmith-cli. -->
      <Component Id="SolidsmithCliAlias">
        <File Id="SolvecraftCliAliasExe" Source="$(var.BinDir)\solvecraft-cli.exe" KeyPath="yes" />
      </Component>
      <!-- Several unversioned files: an explicit GUID (WIX0367). -->
      <Component Id="SolidsmithLicences" Guid="CDEDEE8D-4BE9-4872-A2EA-EE623A6C7E91">
        <File Id="LicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
        <File Id="LicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" />
        <File Id="Notice" Source="$(var.BinDir)\NOTICE" />
        <File Id="ThirdParty" Source="$(var.BinDir)\THIRD-PARTY-LICENSES.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
