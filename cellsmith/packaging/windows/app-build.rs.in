// TEMPLATE for apps/cellsmith/build.rs (copied from Layoutsmith by the release-tooling setup;
// apps/cellsmith didn't exist yet). Move it there and add to apps/cellsmith/Cargo.toml:
//
//   [build-dependencies]
//   # Icon + VERSIONINFO for cellsmith.exe; build.rs only uses it when the target is Windows.
//   winresource = "0.1"
//
// and to apps/cellsmith/src/main.rs (package.ps1 checks the exe is a GUI-subsystem binary):
//
//   #![cfg_attr(all(target_os = "windows", not(debug_assertions)), windows_subsystem = "windows")]
//
// package.ps1 sets CELLSMITH_REQUIRE_WINRES=1 so release builds fail without the resources.

//! Windows only: embed the app icon and version info (VERSIONINFO) into `cellsmith.exe`, so it
//! shows in Explorer, the taskbar, the Start menu and Alt-Tab.
//!
//! On every other target this does nothing. A missing resource compiler is a warning, so a
//! cross-compile from macOS or Linux still links, unless `CELLSMITH_REQUIRE_WINRES=1` turns it
//! into an error (for release builds).

fn main() {
    println!("cargo:rerun-if-changed=build.rs");
    println!("cargo:rerun-if-changed=../../assets/app-icon/cellsmith.ico");
    println!("cargo:rerun-if-env-changed=CELLSMITH_REQUIRE_WINRES");
    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("windows") {
        return;
    }
    let mut res = winresource::WindowsResource::new();
    res.set_icon("../../assets/app-icon/cellsmith.ico")
        .set("ProductName", "Cellsmith")
        .set("FileDescription", "Cellsmith spreadsheet")
        .set("CompanyName", "Learning Machines LLC")
        .set("LegalCopyright", "Copyright (c) the Cellsmith authors. MIT OR Apache-2.0.")
        .set("OriginalFilename", "cellsmith.exe")
        .set("InternalName", "cellsmith");
    if let Err(e) = res.compile() {
        if std::env::var_os("CELLSMITH_REQUIRE_WINRES").is_some() {
            eprintln!("embedding Windows resources failed: {e}");
            std::process::exit(1);
        }
        println!("cargo:warning=cellsmith.exe built without icon/version resources: {e}");
    }
}
